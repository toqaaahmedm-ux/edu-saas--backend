datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Enums Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

// NEW (Admin Report Ã¢â‚¬â€ Bug #1/#2): lets us block login for teachers who
// haven't been approved yet, or for anyone an admin has suspended.
// Students default straight to ACTIVE Ã¢â‚¬â€ the approval gate is only meant
// for TEACHER (and future STAFF-type) roles per the report's flow.
enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  SUSPENDED
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum TenantType {
  TUTOR
  SCHOOL
  UNIVERSITY
  CENTER
}

// what kind of content a lesson holds
enum LessonType {
  VIDEO
  DOCUMENT
  LIVE_SESSION
}

// submission state machine: draft Ã¢â€ â€™ submitted Ã¢â€ â€™ graded (or returned for revision)
enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  RETURNED
}

// attendance options per lesson per student
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Core tenant & billing models Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model Tenant {
  id            String       @id @default(uuid())
  name          String
  subdomain     String       @unique
  customDomain  String?      @unique
  status        TenantStatus @default(TRIAL)
  ownerUserId   String?      @unique
  planId        String?
  trialEndsAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
mediaAssets     MediaAsset[]
  type           TenantType @default(TUTOR)
  gradeScale     String     @default("PERCENT_AF")
  academicConfig Json?

  // Per-tenant branding Ã¢â‚¬â€ lets each school/academy feel like its own
  // platform instead of a generic white-label shell.
  displayName    String?
  logoUrl        String?
  primaryColor   String?    @default("#2563EB") // Tailwind's blue-600, matches current default UI

  plan          Plan?          @relation(fields: [planId], references: [id])
  owner         User?          @relation("TenantOwner", fields: [ownerUserId], references: [id])
  users         User[]         @relation("TenantUsers")
  courses       Course[]
  quizzes       Quiz[]
  lessons       Lesson[]
  enrollments   Enrollment[]
  quizAttempts  QuizAttempt[]
  lessonCompletions  LessonCompletion[]
  certificates  Certificate[]
  notifications Notification[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]

  // sprint 1 additions
  academicYears  AcademicYear[]
  semesters      Semester[]
  gradeLevels    GradeLevel[]
  classSections  ClassSection[]
  modules        Module[]
  assignments    Assignment[]
  attendances    Attendance[]
  grades         Grade[]
  // fix: AssignmentSubmission is now directly tenant-scoped (see model)
  assignmentSubmissions AssignmentSubmission[]

  @@index([status])
}

model Plan {
  id           String       @id @default(uuid())
  name         String       @unique
  billingCycle BillingCycle @default(MONTHLY)
  price        Decimal      @default(0) @db.Decimal(10, 2)
  currency     String       @default("EGP")
  isArchived   Boolean      @default(false)

  maxStudents  Int @default(50)
  maxCourses   Int @default(10)
  maxStorageGb Int @default(5)
  maxLiveHours Int @default(0)
  // NEW (Admin Report Ã‚Â§4.1, P1/P2): course/enrollment limits already existed
  // but quizzes and teacher headcount had no cap at all Ã¢â‚¬â€ a tenant on the
  // cheapest plan could create unlimited quizzes or hire unlimited teachers.
  maxQuizzes   Int @default(20)
  maxTeachers  Int @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  features      PlanFeature[]
  tenants       Tenant[]
  subscriptions Subscription[]
}

model PlanFeature {
  id         String  @id @default(uuid())
  planId     String
  featureKey String
  enabled    Boolean @default(false)
  limitValue Int?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

model Subscription {
  id                 String   @id @default(uuid())
  tenantId           String
  planId             String
  status             String   @default("ACTIVE")
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  gatewayRef         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([tenantId])
}

model Invoice {
  id             String    @id @default(uuid())
  subscriptionId String
  amount         Decimal   @db.Decimal(10, 2)
  currency       String    @default("EGP")
  status         String    @default("PENDING")
  issuedAt       DateTime  @default(now())
  paidAt         DateTime?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  actorId   String?
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([actorId])
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Users Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model User {
  id             String   @id @default(uuid())
  tenantId       String?
  name           String
  email          String
  hashedPassword String
  role           Role     @default(STUDENT)
  avatar         String?
  emailVerified  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // NEW (Admin Report Bug #1/#2, Ã‚Â§4.1 P1/P2): the approval gate. Students
  // default to ACTIVE (no approval needed); TEACHER accounts created via
  // self-registration start PENDING and are blocked from login until an
  // admin approves them. approvedAt/approvedBy give an audit trail of who
  // approved which teacher and when Ã¢â‚¬â€ both null until that happens.
  status      UserStatus @default(ACTIVE)
  approvedAt  DateTime?
  approvedBy  String?

  tenant             Tenant?             @relation("TenantUsers", fields: [tenantId], references: [id], onDelete: Cascade)
  ownedTenant        Tenant?             @relation("TenantOwner")
  verificationTokens VerificationToken[]

  courses       Course[]
  enrollments   Enrollment[]
  quizAttempts  QuizAttempt[]
  lessonCompletions  LessonCompletion[]
  certificates  Certificate[]
  sessions      Session[]
  notifications Notification[]
  auditLogs     AuditLog[]

  // sprint 1 additions
  submissions   AssignmentSubmission[]
  attendances   Attendance[]
  grades        Grade[]
  // students can belong to a class section
  classSection   ClassSection? @relation("SectionStudents", fields: [classSectionId], references: [id])
  classSectionId String?
  // fix: a teacher can be homeroom teacher of one or more sections
  homeroomSections ClassSection[] @relation("SectionHomeroomTeacher")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([classSectionId])
  @@index([status])
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Academic calendar Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

// one row per school year (e.g. "2024Ã¢â‚¬â€œ2025"); only one can be active at a time
model AcademicYear {
  id        String   @id @default(uuid())
  tenantId  String
  name      String   // e.g. "2024-2025"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  semesters Semester[]
  courses   Course[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Fall / Spring / Summer terms inside an academic year
model Semester {
  id             String   @id @default(uuid())
  tenantId       String
  academicYearId String
  name           String   // e.g. "Fall 2024"
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  courses      Course[]

  @@unique([tenantId, academicYearId, name])
  @@index([tenantId])
  @@index([academicYearId])
}

// grade levels differ by tenant type: Grade 1-12 for schools, Year 1-4 for universities
model GradeLevel {
  id           String   @id @default(uuid())
  tenantId     String
  name         String   // e.g. "Grade 10" or "Year 2"
  order        Int      // controls display sort order
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classSections ClassSection[]
  courses       Course[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// a homeroom or lecture section within a grade level (e.g. "Grade 10 - A")
model ClassSection {
  id           String   @id @default(uuid())
  tenantId     String
  gradeLevelId String
  name         String   // e.g. "Section A"
  // fix: homeroomTeacherId is now a real relation, not a bare string
  homeroomTeacherId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gradeLevel       GradeLevel @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  homeroomTeacher  User?      @relation("SectionHomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  students         User[]     @relation("SectionStudents")
  courses          Course[]

  @@unique([tenantId, gradeLevelId, name])
  @@index([tenantId])
  @@index([gradeLevelId])
  @@index([homeroomTeacherId])
}


model Course {
  id           String       @id @default(uuid())
  tenantId     String
  title        String
  description  String
  thumbnail    String?
  videoUrl     String?
  category     String?
  price        Decimal      @default(0) @db.Decimal(10, 2)
  status       CourseStatus @default(DRAFT)
  instructorId String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // academic context Ã¢â‚¬â€ all optional so existing courses don't break
  academicYearId String?
  semesterId     String?
  gradeLevelId   String?
  classSectionId String?
  courseCode     String?     // universities often need a short code like "CS101"
  credits        Int?        // credit hours for university GPA calculation

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instructor   User          @relation(fields: [instructorId], references: [id])
  lessons      Lesson[]
  quizzes      Quiz[]
  enrollments  Enrollment[]
  certificates Certificate[]
  modules      Module[]
  assignments  Assignment[]

  academicYear  AcademicYear?  @relation(fields: [academicYearId], references: [id])
  semester      Semester?      @relation(fields: [semesterId], references: [id])
  gradeLevel    GradeLevel?    @relation(fields: [gradeLevelId], references: [id])
  classSection  ClassSection?  @relation(fields: [classSectionId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([instructorId])
  @@index([semesterId])
  @@index([gradeLevelId])
}

// a chapter/unit that groups lessons inside a course
model Module {
  id          String   @id @default(uuid())
  tenantId    String
  courseId    String
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, order])
  @@index([tenantId])
  @@index([courseId])
}

model LessonCompletion {
  id          String   @id @default(uuid())
  tenantId    String
  studentId   String
  lessonId    String
  completedAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([tenantId])
  @@index([studentId])
  @@index([lessonId])
}
model Lesson {
  id          String      @id @default(uuid())
  tenantId    String
  title       String
  videoUrl    String?
  duration    Int         @default(0)
  order       Int         @default(0)
  courseId    String
  availableAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // sprint 1 additions
  moduleId    String?
  type        LessonType  @default(VIDEO)
  description String?
  isPublished Boolean     @default(false)
  // for LIVE_SESSION lessons: when it starts and the meeting link
  liveAt      DateTime?
  liveUrl     String?

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module      Module?      @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  attendances Attendance[]
  completions LessonCompletion[]

  @@unique([courseId, order])
  @@index([tenantId])
  @@index([courseId])
  @@index([moduleId])
}


model Quiz {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  timeLimit   Int      @default(600)
  passScore   Int      @default(70)   // was missing before Ã¢â‚¬â€ the frontend value was silently dropped
  maxAttempts Int      @default(3)
  courseId    String
  createdAt   DateTime @default(now())

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  @@index([tenantId])
  @@index([courseId])
  @@index([tenantId, courseId])
}

model Question {
  id           String   @id @default(uuid())
  text         String
  options      String[]
  correctIndex Int
  quizId       String
  createdAt    DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}


model Enrollment {
  id         String           @id @default(uuid())
  tenantId   String
  studentId  String
  courseId   String
  progress   Int              @default(0)
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([tenantId])
  @@index([studentId])
  @@index([courseId])
}

model QuizAttempt {
  id          String    @id @default(uuid())
  tenantId    String
  studentId   String
  quizId      String
  score       Int       @default(0)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  answers     Json?     // Task #7: snapshot of submitted answers for review
  createdAt   DateTime  @default(now())

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quiz    Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentId, quizId])
}


model Assignment {
  id           String    @id @default(uuid())
  tenantId     String
  courseId     String
  title        String
  description  String?
  dueDate      DateTime?
  maxScore     Int       @default(100)
  isPublished  Boolean   @default(false)
  allowFileUpload Boolean @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([tenantId])
  @@index([courseId])
}

model AssignmentSubmission {
  id           String           @id @default(uuid())
  // fix: submission is now directly tenant-scoped instead of relying only on
  // assignment.tenantId Ã¢â‚¬â€ same pattern as the Quiz tenantId security fix.
  tenantId     String
  assignmentId String
  studentId    String
  fileUrl      String?          // uploaded file via Cloudinary
  textContent  String?          // for plain-text answers
  status       SubmissionStatus @default(DRAFT)
  score        Int?
  feedback     String?
  submittedAt  DateTime?
  gradedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([tenantId])
  @@index([assignmentId])
  @@index([studentId])
}


// one row per student per lesson Ã¢â‚¬â€ bulk-created by the teacher at the end of class
enum ExcuseStatus {
  PENDING
  APPROVED
  REJECTED
}
model Attendance {n  id        String           @id @default(uuid())n  tenantId  Stringn  lessonId  Stringn  studentId Stringn  status    AttendanceStatus @default(PRESENT)n  note      String?n  markedAt  DateTime         @default(now())n  createdAt DateTime         @default(now())nn  excuseStatus      ExcuseStatus?n  excuseReason      String?n  excuseFileUrl     String?n  excuseRequestedAt DateTime?n  excuseReviewedAt  DateTime?n  excuseReviewedBy  String?nn  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)n  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)n  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)nn  @@unique([lessonId, studentId])n  @@index([tenantId])n  @@index([lessonId])n  @@index([studentId])n  @@index([excuseStatus])n}n
}


model Grade {
  id           String   @id @default(uuid())
  tenantId     String
  studentId    String
  courseId     String
  score        Decimal  @db.Decimal(5, 2)   // weighted average 0Ã¢â‚¬â€œ100
  letterGrade  String?                       // A / B+ / etc., derived from tenant gradeScale
  gpa          Decimal? @db.Decimal(3, 2)   // only populated for UNIVERSITY tenants
  notes        String?
  computedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, courseId])
  @@index([tenantId])
  @@index([studentId])
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Certificates Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model Certificate {
  id              String   @id @default(uuid())
  tenantId        String
  studentId       String
  courseId        String
  issuedAt        DateTime @default(now())
  examName        String   @default("General Exam")
  institutionName String   @default("EduSaaS")
  facultyName     String   @default("Online Learning")
  // sprint 1 fix: store the actual score and academic context on the certificate
  score           Int?
  letterGrade     String?
  academicYearId  String?

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([tenantId])
  @@index([studentId])
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Auth & sessions Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String?
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  id        String                @id @default(uuid())
  userId    String
  token     String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

enum MediaAssetType {
  IMAGE
  VIDEO
  DOCUMENT
}

// Storage usage tracking fix: uploads went to Cloudinary with no record
// of file size or which tenant owns them, so per-tenant storage limits
// (Plan.maxStorageGb) had no real data to enforce against Ã¢â‚¬â€ usage always
// returned 0. This model gives every uploaded file a tenant-scoped row.
model MediaAsset {
  id        String         @id @default(uuid())
  tenantId  String
  uploaderId String
  type      MediaAssetType
  url       String
  publicId  String
  sizeBytes Int
  createdAt DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}